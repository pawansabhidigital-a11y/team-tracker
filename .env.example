# Generate real values with:  npm run gen-auth
#
# Local dev: copy them into .env.local (gitignored).
# Production: add them in Vercel -> Project -> Settings -> Environment Variables.

# Signs the session cookie. Must be set in production.
NEXTAUTH_SECRET=

# Who can sign in: base64-encoded JSON array of
#   { email, name, role, passwordHash }
# Roles: admin (Team Lead) | coordinator (Coordinator) | executive (Executive)
#
# It is base64 rather than plain JSON because a bcrypt hash contains `$`, and
# `$NAME` gets expanded away inside .env files - which silently breaks login.
APP_USERS=
